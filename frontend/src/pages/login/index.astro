---
import LoginForm from '@/features/auth/LoginForm'
import '@/styles/global.css'
import { ViewTransitions } from 'astro:transitions'
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.webp" />
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" />
    <title>Iniciar Sesión - Network.Dashboard</title>
    <ViewTransitions />
  </head>
  <body class="bg-black text-white selection:bg-white selection:text-black font-mono overflow-hidden">
    <div class="relative h-screen w-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-900/20 via-black to-black">
      {/* Decorative background grid */}
      <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(white 1px, transparent 0); background-size: 40px 40px;"></div>
      
      {/* Decorative scanning line effect */}
      <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <div class="w-full h-[2px] bg-white/5 absolute top-0 animate-[scan_8s_linear_infinite]"></div>
      </div>

      {/* Decorative corner elements */}
      <div class="absolute top-8 left-8 w-12 h-12 border-t border-l border-white/20 z-10"></div>
      <div class="absolute top-8 right-8 w-12 h-12 border-t border-r border-white/20 z-10"></div>
      <div class="absolute bottom-24 left-8 w-12 h-12 border-b border-l border-white/20 z-10"></div>
      <div class="absolute bottom-24 right-8 w-12 h-12 border-b border-r border-white/20 z-10"></div>

      <main class="flex-1 flex items-center justify-center relative z-10 px-4">
        <LoginForm client:only="react" />
      </main>

      {/* Subtle footer decoration */}
      <div class="p-6 border-t border-white/5 flex justify-between items-center text-[9px] text-neutral-600 uppercase tracking-[0.4em] relative z-10 bg-black/50 backdrop-blur-sm">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-emerald-500 animate-pulse"></span>
            Node_Status: Secure
          </div>
          <div class="hidden sm:block">Env: Production</div>
        </div>
        <div class="flex items-center gap-4">
          <div class="hidden sm:block">Build: v0.5.2-stable</div>
          <div>© 2026 Network.Intelligence</div>
        </div>
      </div>
    </div>

    <style is:global>
      @keyframes scan {
        from { transform: translateY(-100vh); }
        to { transform: translateY(100vh); }
      }
    </style>
  </body>
</html>
