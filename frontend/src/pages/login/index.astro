---
import LoginForm from '@/features/auth/LoginForm'
import LoginLayout from '@/layouts/login.astro'
---

<LoginLayout>
  <div
    class="relative h-screen w-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-900/20 via-black to-black"
  >
    {/* Decorative background grid */}
    <div
      class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none"
      style="background-image: radial-gradient(white 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>

    {/* Decorative scanning line effect */}
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="w-full h-[2px] bg-white/5 absolute top-0 animate-[scan_8s_linear_infinite]"></div>
    </div>

    {/* Decorative corner elements */}
    <div class="absolute top-8 left-8 w-12 h-12 border-t border-l border-white/20 z-10"></div>
    <div class="absolute top-8 right-8 w-12 h-12 border-t border-r border-white/20 z-10"></div>
    <div class="absolute bottom-8 left-8 w-12 h-12 border-b border-l border-white/20 z-10"></div>
    <div class="absolute bottom-8 right-8 w-12 h-12 border-b border-r border-white/20 z-10"></div>

    <main class="flex-1 flex items-center justify-center relative z-10 px-4">
      <LoginForm client:only="react" />
    </main>
  </div>
</LoginLayout>
